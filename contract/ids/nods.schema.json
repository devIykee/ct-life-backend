{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctlife.dev/contract/ids/nods.schema.json",
  "title": "CT Life community nods",
  "type": "object",
  "required": ["_owner", "_provisional", "version", "defaultRadiusM", "sets", "cosmetics", "nods"],
  "properties": {
    "_owner": { "type": "string" },
    "_provisional": { "type": "boolean" },
    "_note": { "type": "string" },
    "version": { "type": "string" },
    "defaultRadiusM": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 },
    "sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["setId", "name", "reward"],
        "properties": {
          "setId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "reward": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cosmeticId"],
            "properties": { "cosmeticId": { "type": "string", "pattern": "^reward_[a-z0-9_]+$" } }
          }
        }
      }
    },
    "cosmetics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cosmeticId", "name", "slot"],
        "properties": {
          "cosmeticId": { "type": "string", "pattern": "^reward_[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "slot": { "enum": ["skin", "head", "hair", "top", "bottom", "shoes", "acc"] }
        }
      }
    },
    "nods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodId", "name", "setId", "tier", "district", "x", "z"],
        "properties": {
          "nodId": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "setId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "tier": { "enum": ["A", "B", "C"] },
          "district": { "type": "string" },
          "x": { "type": "number" },
          "z": { "type": "number" },
          "radiusM": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 }
        }
      }
    }
  }
}

{
  "title": "nft_gallery.json",
  "type": "object",
  "required": [
    "version",
    "maxSlots",
    "holdingsCacheSec",
    "dasRequestsPerSecond",
    "maxImageBytes",
    "maxImagePx",
    "maxSourceBytes",
    "maxStoredImageBytes",
    "maxNewImagesPerWalletPerDay",
    "devnetCollections",
    "mainnetCollections"
  ],
  "properties": {
    "version": { "type": "string" },
    "_note": { "type": "string" },
    "maxSlots": { "type": "integer", "minimum": 1, "maximum": 64 },
    "holdingsCacheSec": { "type": "integer", "minimum": 60 },
    "dasRequestsPerSecond": { "type": "integer", "minimum": 1, "maximum": 50 },
    "maxImageBytes": { "type": "integer", "minimum": 16384, "maximum": 2097152 },
    "maxImagePx": { "type": "integer", "minimum": 64, "maximum": 2048 },
    "maxSourceBytes": { "type": "integer", "minimum": 65536, "maximum": 33554432 },
    "maxStoredImageBytes": { "type": "integer", "minimum": 1048576 },
    "maxNewImagesPerWalletPerDay": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "devnetCollections": { "$ref": "#/definitions/collections" },
    "mainnetCollections": { "$ref": "#/definitions/collections" }
  },
  "definitions": {
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["address", "name"],
        "properties": {
          "address": { "type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$" },
          "name": { "type": "string", "minLength": 1 },
          "_source": { "type": "string" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "travel.json",
  "description": "Map Travel fares, ride times, limits, bus stops and helipads (docs/TRAVEL.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "roadFactor",
    "minDistanceM",
    "quoteTtlSec",
    "bookDriftM",
    "ticketGraceSec",
    "arriveEarlySec",
    "cooldownSec",
    "tripsPerHour",
    "arrivalOffsetM",
    "gatedBooking",
    "walk",
    "busStopRadiusM",
    "modes",
    "busStops",
    "heliPadRadiusM",
    "heliHomeKinds",
    "heliPads",
    "homePads"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "_note": {
      "type": "string"
    },
    "roadFactor": {
      "type": "number",
      "minimum": 1
    },
    "minDistanceM": {
      "type": "number",
      "minimum": 0
    },
    "quoteTtlSec": {
      "type": "integer",
      "minimum": 5
    },
    "bookDriftM": {
      "type": "number",
      "minimum": 0
    },
    "ticketGraceSec": {
      "type": "integer",
      "minimum": 10
    },
    "arriveEarlySec": {
      "type": "number",
      "minimum": 0
    },
    "cooldownSec": {
      "type": "integer",
      "minimum": 0
    },
    "tripsPerHour": {
      "type": "integer",
      "minimum": 1
    },
    "arrivalOffsetM": {
      "type": "number",
      "minimum": 0
    },
    "gatedBooking": {
      "enum": ["warn", "refuse"]
    },
    "walk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speedMps"],
      "properties": {
        "speedMps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 6.5
        }
      }
    },
    "busStopRadiusM": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bus", "taxi", "heli"],
      "properties": {
        "bus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseCents",
            "perHundredMCents",
            "minCents",
            "capCents",
            "baseSec",
            "speedMps",
            "unlockNetWorthCents",
            "pickup"
          ],
          "properties": {
            "baseCents": {
              "type": "integer",
              "minimum": 0
            },
            "perHundredMCents": {
              "type": "integer",
              "minimum": 0
            },
            "minCents": {
              "type": "integer",
              "minimum": 0
            },
            "capCents": {
              "type": "integer",
              "minimum": 0
            },
            "baseSec": {
              "type": "number",
              "minimum": 0
            },
            "speedMps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unlockNetWorthCents": {
              "type": "integer",
              "minimum": 0
            },
            "pickup": {
              "enum": ["stop", "anywhere", "pad"]
            }
          }
        },
        "taxi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseCents",
            "perHundredMCents",
            "minCents",
            "capCents",
            "baseSec",
            "speedMps",
            "unlockNetWorthCents",
            "pickup"
          ],
          "properties": {
            "baseCents": {
              "type": "integer",
              "minimum": 0
            },
            "perHundredMCents": {
              "type": "integer",
              "minimum": 0
            },
            "minCents": {
              "type": "integer",
              "minimum": 0
            },
            "capCents": {
              "type": "integer",
              "minimum": 0
            },
            "baseSec": {
              "type": "number",
              "minimum": 0
            },
            "speedMps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unlockNetWorthCents": {
              "type": "integer",
              "minimum": 0
            },
            "pickup": {
              "enum": ["stop", "anywhere"]
            }
          }
        },
        "heli": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseCents",
            "perHundredMCents",
            "minCents",
            "capCents",
            "baseSec",
            "speedMps",
            "unlockNetWorthCents",
            "pickup"
          ],
          "properties": {
            "baseCents": {
              "type": "integer",
              "minimum": 0
            },
            "perHundredMCents": {
              "type": "integer",
              "minimum": 0
            },
            "minCents": {
              "type": "integer",
              "minimum": 0
            },
            "capCents": {
              "type": "integer",
              "minimum": 0
            },
            "baseSec": {
              "type": "number",
              "minimum": 0
            },
            "speedMps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unlockNetWorthCents": {
              "type": "integer",
              "minimum": 0
            },
            "pickup": {
              "enum": ["stop", "anywhere", "pad"]
            }
          }
        }
      }
    },
    "busStops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "district", "x", "z", "yaw", "shelter"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "district": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "yaw": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "shelter": {
            "enum": ["baked", "kit"]
          }
        }
      }
    },
    "heliPadRadiusM": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "heliHomeKinds": {
      "type": "array",
      "items": {
        "enum": ["parents_basement", "hacker_house", "studio", "penthouse", "marina_villa"]
      },
      "uniqueItems": true
    },
    "heliPads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "district", "x", "z"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "district": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          }
        }
      }
    },
    "homePads": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "district", "x", "z"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "district": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          }
        }
      },
      "propertyNames": {
        "enum": ["parents_basement", "hacker_house", "studio", "penthouse", "marina_villa"]
      }
    }
  }
}

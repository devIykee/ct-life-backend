{
  "title": "businesses.json",
  "type": "object",
  "required": ["version", "businesses"],
  "properties": {
    "version": { "type": "string" },
    "maxPendingPayouts": {
      "type": "integer",
      "minimum": 1,
      "description": "Payout periods that can pile up uncollected; older ones are not paid."
    },
    "businesses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "costCents",
          "incomeRangeCents",
          "badDayChanceBps",
          "badDayMultiplier"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "costCents": { "type": "integer", "minimum": 0 },
          "incomeRangeCents": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer" }
          },
          "badDayChanceBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "badDayMultiplier": { "type": "number", "minimum": 0, "maximum": 1 },
          "payoutPeriodHours": { "type": "integer", "minimum": 1 },
          "sellBackBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "maxOwned": { "type": "integer", "minimum": 1 },
          "badDays": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "weight"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "weight": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}

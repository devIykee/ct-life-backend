# =============================================================================
# CT Life backend — environment variables
# =============================================================================
# Every variable referenced in code MUST appear here and in README.md. The
# docs-check script (tools/scripts/docs-check.ts) verifies this in CI.
#
# Sections:
#   1. Process
#   2. Solana
#   3. Helius
#   4. LiveKit
#   5. Database and cache
#   6. Auth
#   7. Storage (S3)
#   8. Auth flags
#   9. Optional M5+ (push, LLM, X)
#  10. Optional M8 (Sentry, Railway)
#  11. Test safe-mode flags
# =============================================================================

# --- 1. Process -------------------------------------------------------------
# APP_ENV picks the deployment profile: local | mock | staging | prod.
# NODE_ENV follows APP_ENV (production for staging/prod, development otherwise).
APP_ENV=local
# APP_ENV=prod selects the Solana MAINNET cluster for every on-chain feature. The
# API, realtime and workers refuse to boot on mainnet unless ALLOW_MAINNET=1.
# Leave empty until the mainnet legal review is done.
ALLOW_MAINNET=
NODE_ENV=development
LOG_LEVEL=info
PORT_API=4010
PORT_REALTIME=2567
PORT_WORKERS=0                # 0 = no HTTP listen; workers talk via Redis

# --- 2. Solana ---------------------------------------------------------------
# Two clusters. Devnet for daily work and tests; mainnet for ORE / SGT reads
# (always) and the prod environment.
SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com
SOLANA_RPC_URL_MAINNET=https://api.mainnet-beta.solana.com
SOLANA_WS_URL_DEVNET=wss://api.devnet.solana.com
SOLANA_WS_URL_MAINNET=wss://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed
SOLANA_FINALIZED_COMMITMENT=finalized

# Treasury: a wallet the backend reads transactions into. USDC, SOL, SKR and
# ORE payments are sent here. Two separate wallets for devnet and mainnet.
TREASURY_PUBKEY_DEVNET=
TREASURY_PUBKEY_MAINNET=

# Settle authority: the backend's signer for the ct_escrow program. Two
# separate keypairs. Stored as base58 (preferred) or as a path to a JSON
# keypair file. NEVER commit the file.
SETTLE_AUTHORITY_KEYPAIR_DEVNET=
SETTLE_AUTHORITY_KEYPAIR_MAINNET=

# Admin keypair: signs admin / moderation actions on chain. Two separate
# keypairs. Devnet only is required for M0; mainnet only for prod.
ADMIN_KEYPAIR_DEVNET=
ADMIN_KEYPAIR_MAINNET=

# ct_escrow program ID. Filled after first deploy. M0 leaves empty.
CT_ESCROW_PROGRAM_ID_DEVNET=
CT_ESCROW_PROGRAM_ID_MAINNET=

# --- 3. Helius ---------------------------------------------------------------
# Used for enhanced RPC (getTokenAccountsByOwnerV2 for SGT, transaction
# fetches, webhooks). The free tier covers devnet; mainnet reads also count.
HELIUS_API_KEY=
HELIUS_RPC_URL_DEVNET=https://devnet.helius-rpc.com
HELIUS_RPC_URL_MAINNET=https://mainnet.helius-rpc.com
HELIUS_WEBHOOK_SECRET=
# Metaplex Core collection of the hovercar pass; empty = no wallet sync (ops grants only).
HOVERCAR_COLLECTION=
# GET /v1/config flags.wireV3Kinds: true tells the client to send the v3 vehicle kinds (set once deployed).
WIRE_V3_KINDS=false

# --- 3b. Push (Firebase Cloud Messaging, HTTP v1) -----------------------------
# Leave all three empty and push is a logged no-op (the legacy FCM_SERVER_KEY in section 9 is not used). See docs/PUSH.md for the
# Firebase setup. NEVER commit the service-account file or paste it into git.
FCM_PROJECT_ID=
# The service-account JSON as one line, OR the path to the file below.
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH=

# --- 4. LiveKit --------------------------------------------------------------
# Local dev: docker compose runs livekit/livekit:v1.13.7. Staging/prod:
# LiveKit Cloud. The SDK uses the same token API for either.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_please_change
LIVEKIT_WEBHOOK_SECRET=

# --- 5. Database and cache ---------------------------------------------------
# Postgres 16, Redis 7. Local defaults point at the compose stack. Staging and
# prod get Railway-managed URLs.
DATABASE_URL=postgres://ctlife:ctlife@localhost:5432/ctlife
DATABASE_SSL=false
# Postgres connections per process (api, realtime, workers each open a pool).
# Keep (sum over every replica) under the server's max_connections. docs/LOAD-TEST.md.
DB_POOL_MAX=20
REDIS_URL=redis://localhost:6379/0
REDIS_TLS=false

# Test database configuration (used by test suite for isolation)
TEST_DATABASE_URL=postgres://ctlife:ctlife@localhost:5432/ctlife_test
TEST_SCHEMA=test

# Solana RPC for mainnet verification tests (guarded by RUN_MAINNET_TESTS=1)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- 6. Auth -----------------------------------------------------------------
# RS256 JWT, 15-min access, 30-day refresh with rotation and revocation.
# The public key is served at /v1/auth/jwks. Kid supports rotation.
# If JWT_PRIVATE_KEY is empty in local/mock, a key is generated on first boot
# and persisted to ./.runtime/jwt-private.pem.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=ctlife-1
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# SIWS (Sign In With Solana) configuration
# domain: The domain shown in the SIWS challenge. Must match the client's
#   MWA app identity exactly or every sign-in is rejected.
# uri: The URI shown in the challenge (keep the trailing slash)
SIWS_DOMAIN=ctlife.fun
SIWS_URI=https://ctlife.fun/

# --- 7. Storage (S3) ---------------------------------------------------------
# MinIO in compose. Any S3-compatible store in staging/prod. Used for ad
# uploads and (in M5) cosmetic NFT assets.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ctlife-uploads
S3_FORCE_PATH_STYLE=true

# --- 8. Auth flags -----------------------------------------------------------
# Dev auth: POST /v1/auth/dev exists only when ENABLE_DEV_AUTH=true. The build
# hard-fails at startup if this is true and APP_ENV in {staging, prod} or
# NODE_ENV=production.
ENABLE_DEV_AUTH=false
ALLOW_ALIAS_OVERRIDE=false    # dev only; lets bots reuse a single alias
ADMIN_WALLETS=                # comma-separated Solana wallet addresses for admin routes

# --- 9. Optional M5+ ---------------------------------------------------------
# Push notifications. Off by default until Seeker Google Play services is
# confirmed. When off, the in-app inbox is the only notification surface.
PUSH_ENABLED=false
PUSH_PROVIDER=fcm             # fcm | apns (apns not used on Seeker)
FCM_SERVER_KEY=

# The Rug Room (casino): per-player daily caps in cents, UTC day. Play money only.
CASINO_DAILY_STAKE_CAP_CENTS=50000
CASINO_DAILY_LOSS_CAP_CENTS=25000

# Release phase opened for clients (GET /config livePhase), 1 to 6. Default 1. Set 6 to open every app.
LIVE_PHASE=1

# Finished-but-dark features this deployment turns on (GET /config `capabilities`),
# comma list, e.g. worldEvents,districtStandings. Empty = everything off. Unknown
# names are ignored (and logged at boot); names are case-sensitive. There are no code
# defaults: add a name only after its feature PR has deployed. Names:
#   apps:     beef builder vc predict
#   features: beefVoting districtStandings seasonResults sybilBail sybilBarn cabalRevoke
#             xUnlink worldEvents homeMove visitorPolicy nftGallery paidCalls creatorMode
#             seasonPassPurchase factory projectHq devnetDrip
#   derived:  cabalInvites (competitionCapabilities.targetedCabalInvites)
CAPABILITIES_ON=

# Devnet SOL drip (POST /v1/devnet/drip, capability devnetDrip; devnet only). A throwaway
# DEVNET ops-treasury keypair (path to a Solana CLI JSON file, or base58) that holds
# only devnet SOL and is used for nothing else. Empty = the drip is unconfigured.
DEVNET_DRIP_KEYPAIR=
# Lamports per drip (default 20000000 = 0.02 SOL, max 0.1 SOL) and the global daily
# budget across all players (default 1000000000 = 1 SOL, max 10 SOL).
DEVNET_DRIP_LAMPORTS=
DEVNET_DRIP_DAILY_CAP_LAMPORTS=

# Cash tips: fee BURNED on every tip, in basis points (300 = 3%). 0 turns it off.
TIP_FEE_BPS=300

# Rugpull Factory: REAL token launches on Meteora DBC (docs/FACTORY-REAL.md).
# FACTORY_DBC_CONFIG is the PUBLIC address of our partner config, created once per
# cluster with tools/factory/create-dbc-config.ts. Empty = launches answer 503.
# PARTNER_FEE_WALLET is the public address that claims our trading fees (a
# multisig is recommended). No private key is ever configured here.
FACTORY_DBC_CONFIG=
PARTNER_FEE_WALLET=
FACTORY_PRIORITY_MICROLAMPORTS=50000
FACTORY_COMPUTE_UNIT_LIMIT=300000
# Token image + metadata: pinata (permanent IPFS; PINATA_JWT + PINATA_GATEWAY) or
# self (served by this API from Postgres at PUBLIC_API_BASE_URL; devnet).
FACTORY_METADATA_STORE=self
PINATA_JWT=
PINATA_GATEWAY=
PUBLIC_API_BASE_URL=
# Helius raw webhook (raw / rawDevnet) watching creator wallets and pools; the
# server adds addresses on each launch. AUTH = the exact Authorization header
# value configured on the webhook.
HELIUS_FACTORY_WEBHOOK_ID=
HELIUS_FACTORY_WEBHOOK_AUTH=
# Server-side product analytics (docs/ANALYTICS.md): funnel and economy events
# in Postgres, user id only. false stops the writes; rows are deleted after
# ANALYTICS_RETENTION_DAYS by the workers.
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=180

# LLM chat for the AI Agent and Sleuth archetypes (M7). Off by default.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=                # e.g. the LLM provider's flagship model; the operator picks this per their account

# X (Twitter) link (M7). Off by default; if credentials are absent the flag
# stays off and the feature is hidden client-side.
X_LINK_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
X_AUTHORIZE_URL=https://x.com/i/oauth2/authorize
X_TOKEN_URL=https://api.x.com/2/oauth2/token
X_ME_URL=https://api.x.com/2/users/me

# --- 10. Optional M8 ---------------------------------------------------------
SENTRY_DSN=
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=

# Operator-only character likeness evaluation. Leave empty by default.
# A key does not enable public generation; explicit evaluation budget is required.
TRIPO_API_KEY=
LIKENESS_PRICE_USDC_CENTS=300
LIKENESS_GENERATION_ENABLED=false
TRIPO_END_USER_AGREEMENT_CONFIRMED=false
LIKENESS_OPERATOR_EVALUATION_ENABLED=false
LIKENESS_OPERATOR_USER_IDS=
LIKENESS_RUNTIME_PROFILE_CONFIRMED=false
LIKENESS_PRIVATE_STORAGE_CONFIRMED=false
LIKENESS_PRIVATE_BUCKET=
# Keys scoped to the private bucket only. Endpoint/region/path style fall back to S3_*.
LIKENESS_S3_ACCESS_KEY=
LIKENESS_S3_SECRET_KEY=
LIKENESS_S3_ENDPOINT=
LIKENESS_S3_REGION=
LIKENESS_S3_FORCE_PATH_STYLE=
LIKENESS_REFERENCE_MANIFEST=
# Local development only; never configure this on hosted production.
LIKENESS_LOCAL_DIRECTORY=

# --- 11. Test safe-mode ------------------------------------------------------
# Mainnet tests that move real value. Default off everywhere.
RUN_MAINNET_TESTS=0
# E2E tests that hit external services. Default off in CI unit, on in nightly.
ENABLE_E2E=0

# SGT override (dev only): force isSeeker=true without checking the token.
# Never set this in staging or prod.
SGT_OVERRIDE=

# ORE devnet override: if true, the ORE module on devnet returns the last
# cached mainnet value instead of failing. Default false.
ORE_DEVNET_USE_MAINNET_CACHE=false

# ORE mainnet reader: when 1, GET /v1/ore/board and /v1/ore/me read the ORE
# accounts from HELIUS_RPC_URL_MAINNET (read-only, no transactions). Set it in
# staging and prod: with it off the board answers 503 SERVER_BUSY and /config
# lists `ore_reader` as degraded. Default off so dev never depends on mainnet
# (local serves a fixture board).
ORE_READER_ENABLED=0

# Prediction settlement sweep (workers). Off unless set to 1. Keep it off in
# prod: resolveOutcome in server/application/predictions.ts is a dev stub
# (the canned market flips each minute; every other outcome loses), and
# POST /v1/predictions does not check outcomeId against a market list.
PREDICTIONS_SETTLEMENT_ENABLED=0

# One-time Cash bonus (cents) for an accepted IRL event check-in. Default 10000.
EVENT_IRL_BONUS_CENTS=10000
